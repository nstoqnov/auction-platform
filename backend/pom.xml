	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.11</version>
				<configuration>
					<excludes>
						<exclude>com/example/auction/AuctionApplication.class</exclude>
						<exclude>com/example/auction/DTOs/**</exclude>
						<exclude>com/example/auction/Configurations/**</exclude>
						<exclude>com/example/auction/Security/SecurityConfig.class</exclude>
						<exclude>com/example/auction/Security/OAuth2LoginSuccessHandler.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
